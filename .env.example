// 1. Tambahkan konstanta Base URL Backend
// Sesuaikan IP ini jika kamu mengetes menggunakan Emulator HP (Gunakan IP WiFi komputer, contoh: http://192.168.1.5:3001)
// Jika hanya mengetes di Browser Web komputer, gunakan http://localhost:3001
const API_BASE_URL = "http://localhost:3001";

async function request<T>(path: string, options: RequestInit = {}): Promise<T> {
  // 2. Gabungkan API_BASE_URL dengan path
  const response = await fetch(`${API_BASE_URL}${path}`, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(getToken() ? { Authorization: `Bearer ${getToken()}` } : {}),
      ...options.headers,
    },
  });
  
  const body = await response.json().catch(() => ({}));
  
  if (!response.ok) {
     throw new Error(body.message || "Permintaan ke server gagal.");
  }
  
  return body as T;
}

